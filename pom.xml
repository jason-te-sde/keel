<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.jason-te-sde</groupId>
  <artifactId>keel-parent</artifactId>
  <version>0.3.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>keel</name>
  <description>
    A linearizable distributed key-value store: a from-scratch Raft implementation,
    a deterministic fault-injection simulator, and a linearizability checker.
  </description>
  <url>https://github.com/jason-te-sde/keel</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>jason-te-sde</id>
      <name>Jason Te</name>
      <url>https://github.com/jason-te-sde</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/jason-te-sde/keel.git</connection>
    <developerConnection>scm:git:git@github.com:jason-te-sde/keel.git</developerConnection>
    <url>https://github.com/jason-te-sde/keel</url>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jason-te-sde/keel/issues</url>
  </issueManagement>

  <modules>
    <module>keel-proto</module>
    <module>keel-raft</module>
    <module>keel-storage</module>
    <module>keel-kv</module>
    <module>keel-testkit</module>
    <module>keel-node</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- protobuf-java and grpc-java releases are coupled; bump them together. -->
    <protobuf.version>4.29.3</protobuf.version>
    <grpc.version>1.70.0</grpc.version>

    <slf4j.version>2.0.16</slf4j.version>
    <log4j.version>2.24.3</log4j.version>
    <rocksdb.version>9.7.3</rocksdb.version>
    <junit.version>5.11.4</junit.version>

    <compiler.plugin.version>3.13.0</compiler.plugin.version>
    <surefire.plugin.version>3.5.2</surefire.plugin.version>
    <jacoco.plugin.version>0.8.12</jacoco.plugin.version>
    <enforcer.plugin.version>3.5.0</enforcer.plugin.version>
    <shade.plugin.version>3.6.0</shade.plugin.version>
    <protobuf.plugin.version>0.6.1</protobuf.plugin.version>
    <source.plugin.version>3.3.1</source.plugin.version>
    <javadoc.plugin.version>3.11.2</javadoc.plugin.version>
    <gpg.plugin.version>3.2.7</gpg.plugin.version>
    <central.plugin.version>0.7.0</central.plugin.version>
    <os.plugin.version>1.7.1</os.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-bom</artifactId>
        <version>${protobuf.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-slf4j2-impl</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-core</artifactId>
        <version>${log4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.rocksdb</groupId>
        <artifactId>rocksdbjni</artifactId>
        <version>${rocksdb.version}</version>
      </dependency>

      <!-- Modules -->
      <dependency>
        <groupId>io.github.jason-te-sde</groupId>
        <artifactId>keel-proto</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jason-te-sde</groupId>
        <artifactId>keel-raft</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jason-te-sde</groupId>
        <artifactId>keel-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jason-te-sde</groupId>
        <artifactId>keel-kv</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
          <configuration>
            <!-- No module uses an annotation processor. Saying so explicitly stops the compiler
                 warning that nothing claimed the annotations it found on the classpath, which
                 arrives as soon as a dependency happens to ship a processor. -->
            <proc>none</proc>
            <compilerArgs>
              <!-- Warnings are build failures. Two lint categories are off on
                   purpose: 'serial' fires on exception classes that are never
                   serialized, and 'this-escape' fires on any constructor that
                   calls an overridable method, which is unavoidable here. -->
              <arg>-Xlint:all,-serial,-this-escape</arg>
              <arg>-Werror</arg>
            </compilerArgs>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.plugin.version}</version>
          <configuration>
            <!-- Test classes run in parallel, methods within a class do not:
                 several suites share a temporary directory per class. -->
            <properties>
              <configurationParameters>
                junit.jupiter.execution.parallel.enabled = true
                junit.jupiter.execution.parallel.mode.default = same_thread
                junit.jupiter.execution.parallel.mode.classes.default = concurrent
              </configurationParameters>
            </properties>
          </configuration>
        </plugin>

        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${shade.plugin.version}</version>
        </plugin>

        <plugin>
          <groupId>org.xolstice.maven.plugins</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>${protobuf.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-environment</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <!-- A declared module that does not exist, or a version that
                     drifts between modules, breaks a clean clone. Both were
                     real failures in an earlier project of mine. -->
                <reactorModuleConvergence/>
                <requireUpperBoundDeps/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Artifacts a consumer needs: the jar alone is not enough to read or debug against. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${source.plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${javadoc.plugin.version}</version>
            <configuration>
              <!-- Reject broken references and malformed HTML, but not missing tags on internals.
                   Failing a release because a package-private helper lacks an @param would make
                   the check something to disable rather than something to satisfy. -->
              <doclint>all,-missing</doclint>
              <quiet>true</quiet>
              <!-- keel-proto skips javadoc, so cross-linking to it would look for output that
                   was never generated and log an error per module. -->
              <detectOfflineLinks>false</detectOfflineLinks>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadoc</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Signing and upload. Kept apart from `release` so building the release artifacts locally
         does not require a GPG key, and so a mistake here cannot silently skip signing. -->
    <profile>
      <id>publish</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${gpg.plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central.plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- Deliberately manual: a release should be looked at in the portal before it
                   becomes permanent, because a published version can never be replaced. -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Coverage runs under one JDK rather than the whole matrix: the JaCoCo
         agent has to understand the class file version of the JDK it runs on,
         which makes it the first thing to break on a new release. Enable with
         -Dcoverage. -->
    <profile>
      <id>coverage</id>
      <activation>
        <property><name>coverage</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.plugin.version}</version>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals><goal>prepare-agent</goal></goals>
              </execution>
              <execution>
                <id>report</id>
                <phase>verify</phase>
                <goals><goal>report</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
